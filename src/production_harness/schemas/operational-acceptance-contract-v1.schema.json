{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dariaGlint/harness/schemas/operational-acceptance-contract-v1.schema.json",
  "title": "production-harness operational acceptance contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "subject_id", "gates", "verdict_policy", "contract_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "operational_acceptance_contract"},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "required", "allowed_statuses", "required_evidence_roles", "description"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
          "required": {"type": "boolean"},
          "allowed_statuses": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["pass", "fail", "blocked", "skipped"]}
          },
          "required_evidence_roles": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}
        }
      }
    },
    "verdict_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed_required", "failed_optional", "missing_required", "blocked_required", "skipped_required"],
      "properties": {
        "failed_required": {"const": "fail"},
        "failed_optional": {"enum": ["fail", "ignore"]},
        "missing_required": {"const": "blocked"},
        "blocked_required": {"const": "blocked"},
        "skipped_required": {"const": "blocked"}
      }
    },
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
