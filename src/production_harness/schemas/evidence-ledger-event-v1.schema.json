{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dariaGlint/harness/schemas/evidence-ledger-event-v1.schema.json",
  "title": "production-harness evidence ledger event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "timestamp",
    "event_type",
    "subject_id",
    "actor",
    "payload",
    "evidence",
    "previous_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "actor": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "payload": {"type": "object"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "size_bytes", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1, "maxLength": 128},
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "previous_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
