{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dariaglint.github.io/production-harness/schemas/workspace_commit_handoff_v1.json",
  "title": "Workspace Commit Bridge handoff",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "commit_bridge"
      ],
      "properties": {
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "commit_bridge": {
          "$ref": "#/$defs/commitBridge"
        }
      }
    },
    {
      "$ref": "#/$defs/commitBridge"
    }
  ],
  "$defs": {
    "commitBridge": {
      "type": "object",
      "required": [
        "schema_version",
        "repository",
        "base_sha",
        "files"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "workspace_root": {
          "type": "string"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "direct_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_suffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_basenames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "operation",
                  "mode",
                  "size_bytes",
                  "sha256",
                  "git_blob_sha"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "enum": [
                      "add",
                      "modify"
                    ]
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$"
                  },
                  "git_blob_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{40}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "operation"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "const": "delete"
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
