{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dariaglint.github.io/production-harness/schemas/workspace_commit_handoff_v1.json",
  "title": "Workspace Commit Bridge handoff v1",
  "type": "object",
  "required": [
    "issue_number",
    "base_master_sha",
    "repository",
    "changed_files",
    "behavior_change",
    "validation_results",
    "preview_approved",
    "next_action",
    "commit_bridge"
  ],
  "properties": {
    "issue_number": {"type": "integer", "minimum": 1},
    "base_master_sha": {"$ref": "#/$defs/gitSha"},
    "repository": {"$ref": "#/$defs/repository"},
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "purpose": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "behavior_change": {"type": "boolean"},
    "validation_results": {"type": "array"},
    "preview_approved": {"type": "boolean"},
    "next_action": {"const": "commit"},
    "task_id": {"type": "string", "minLength": 1},
    "controller_run_id": {"type": "string", "minLength": 1},
    "transaction_id": {"type": "string", "minLength": 1},
    "validation_ownership": {"type": "object"},
    "commit_bridge": {"$ref": "#/$defs/commitBridge"}
  },
  "additionalProperties": true,
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commitBridge": {
      "type": "object",
      "required": ["schema_version", "repository", "base_sha", "files"],
      "properties": {
        "schema_version": {"const": 1},
        "repository": {"$ref": "#/$defs/repository"},
        "base_sha": {"$ref": "#/$defs/gitSha"},
        "workspace_root": {"type": "string"},
        "issue_number": {"type": "integer", "minimum": 1},
        "direct_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"oneOf": [
            {"$ref": "#/$defs/writeFile"},
            {"$ref": "#/$defs/deleteFile"}
          ]}
        }
      },
      "additionalProperties": false
    },
    "writeFile": {
      "type": "object",
      "required": ["path", "operation", "mode", "size_bytes", "sha256", "git_blob_sha"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "operation": {"enum": ["add", "modify"]},
        "mode": {"enum": ["100644", "100755"]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "git_blob_sha": {"$ref": "#/$defs/gitSha"},
        "purpose": {"type": "string", "minLength": 1},
        "encoding": {"enum": ["utf-8", "binary"]},
        "allow_empty": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "deleteFile": {
      "type": "object",
      "required": ["path", "operation"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "operation": {"const": "delete"},
        "purpose": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
